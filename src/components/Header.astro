---
import site from '../content/site.json';
import T from './T.astro';
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="#top">
      <span class="brand-mark" aria-hidden="true">{site.brand.initials}</span>
      <span class="brand-name">{site.brand.name}<i class="brand-acute" aria-hidden="true">˝</i></span>
    </a>

    <button id="menu-btn" class="menu-btn" aria-expanded="false" aria-controls="site-nav"
      data-al-en="Open menu" data-al-hu="Menü megnyitása" data-al-pl="Otwórz menu" aria-label="Open menu">☰</button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      {site.nav.map((item) => (
        <a href={`#${item.id}`}><T t={item.label} /></a>
      ))}
    </nav>

    <!-- MASTER SWITCH — always on screen (sticky header): EN → HU → PL → EN -->
    <button id="lang-switch" class="lang-switch" type="button"
      data-al-en="Switch language (English → Hungarian → Polish)"
      data-al-hu="Nyelvváltás (angol → magyar → lengyel)"
      data-al-pl="Zmień język (angielski → węgierski → polski)"
      aria-label="Switch language (English → Hungarian → Polish)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18M12 3c2.6 2.6 3.9 5.7 3.9 9S14.6 18.4 12 21c-2.6-2.6-3.9-5.7-3.9-9S9.4 5.6 12 3Z" />
      </svg>
      <b>EN</b>
    </button>

    <!-- Style switch — always on screen (sticky header): cycles Literary → Manuscript → Warm -->
    <button id="theme-switch" class="theme-switch" type="button"
      data-al-en="Change style (Literary → Manuscript → Warm)"
      data-al-hu="Stílusváltás (irodalmi → kézirat → meleg)"
      data-al-pl="Zmień styl (literacki → rękopis → ciepły)"
      aria-label="Change style (Literary → Manuscript → Warm)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="theme-switch__icon">
        <circle cx="9" cy="9" r="6" />
        <circle cx="15" cy="15" r="6" />
      </svg>
      <b>Literary</b>
    </button>

    <!-- Colour switch — always on screen (sticky header): cycles Warm → Cool → Bold -->
    <button id="palette-switch" class="palette-switch" type="button"
      data-al-en="Change colours (Warm → Cool → Bold)"
      data-al-hu="Színváltás (meleg → hűvös → erős)"
      data-al-pl="Zmień kolory (ciepłe → chłodne → mocne)"
      aria-label="Change colours (Warm → Cool → Bold)">
      <span class="palette-swatch" aria-hidden="true"></span>
      <b>Warm</b>
    </button>
  </div>
</header>
