---
// T — trilingual text.
//   default : renders ONLY the active language (from the URL) as inline text.
//             One language per route → crawlable, no-JS correct, minimal DOM.
//   all=true: renders all three languages as sibling spans toggled by html[data-lang]
//             (see global.css). Used only by the single GitHub-Pages 404.html.
import { localeFromUrl } from '../lib/locale';
export interface Tr { en: string; hu: string; pl: string }
const { t, all = false } = Astro.props as { t: Tr; all?: boolean };
const lang = localeFromUrl(Astro.url);
---
{all ? (
  <Fragment><span class="t" lang="en">{t.en}</span><span class="t" lang="hu">{t.hu}</span><span class="t" lang="pl">{t.pl}</span></Fragment>
) : (
  t[lang]
)}
