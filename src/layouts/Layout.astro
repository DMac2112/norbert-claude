---
import '../styles/global.css';
import '../styles/fonts.css';
import '../styles/palettes.css';
import '../styles/theme-literary.css';
import '../styles/theme-manuscript.css';
import '../styles/theme-warm.css';
import site from '../content/site.json';
import { localeFromUrl, type Lang } from '../lib/locale';

interface Props { noindex?: boolean }
const { noindex = false } = Astro.props;

const meta = site.meta;
const lang = localeFromUrl(Astro.url);

// Absolute URLs on the project-site base, e.g. https://dmac2112.github.io/norbert-claude/hu/
const origin = new URL(import.meta.env.BASE_URL, import.meta.env.SITE); // …/norbert-claude/
const localeUrl = (loc: Lang) => (loc === 'en' ? origin.href : new URL(`${loc}/`, origin).href);
const urlEn = localeUrl('en');
const urlHu = localeUrl('hu');
const urlPl = localeUrl('pl');
const selfUrl = localeUrl(lang);

const OG_LOCALE: Record<Lang, string> = { en: 'en_GB', hu: 'hu_HU', pl: 'pl_PL' };
const ogAlternates = (['en', 'hu', 'pl'] as Lang[]).filter((l) => l !== lang).map((l) => OG_LOCALE[l]);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': urlEn + '#norbert',
  name: site.brand.name,
  jobTitle: site.brand.tagline[lang],
  description: meta.description[lang],
  url: urlEn,
  knowsLanguage: ['hu', 'en', 'pl'],
  knowsAbout: [
    'Hungarian–English translation',
    'Localization',
    'Subtitling',
    'Piano teaching',
    'Guitar teaching',
  ],
  address: { '@type': 'PostalAddress', addressLocality: 'Poznań', addressCountry: 'PL' },
  areaServed: [
    { '@type': 'Country', name: 'Poland' },
    { '@type': 'Country', name: 'United Kingdom' },
    { '@type': 'Country', name: 'Hungary' },
  ],
  makesOffer: [
    { '@type': 'Offer', itemOffered: { '@type': 'Service', serviceType: site.translation.heading[lang], provider: { '@id': urlEn + '#norbert' } } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', serviceType: site.music.heading[lang], provider: { '@id': urlEn + '#norbert' } } },
  ],
};

// Pre-paint language restore — 404 only (indexable pages are fixed by their URL).
const langRestore = `(function(){try{var l=localStorage.getItem('nb.lang');if(l==='hu'||l==='pl'||l==='en'){document.documentElement.lang=l;document.documentElement.dataset.lang=l;}}catch(e){}})();`;
---
<!doctype html>
<html lang={lang} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title[lang]}</title>
    <meta name="description" content={meta.description[lang]} />

    {!noindex && (
      <Fragment>
        <link rel="canonical" href={selfUrl} />
        <link rel="alternate" hreflang="en" href={urlEn} />
        <link rel="alternate" hreflang="hu" href={urlHu} />
        <link rel="alternate" hreflang="pl" href={urlPl} />
        <link rel="alternate" hreflang="x-default" href={urlEn} />
        <meta property="og:site_name" content={site.brand.name} />
        <meta property="og:title" content={meta.title[lang]} />
        <meta property="og:description" content={meta.description[lang]} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={selfUrl} />
        <meta property="og:locale" content={OG_LOCALE[lang]} />
        {ogAlternates.map((l) => <meta property="og:locale:alternate" content={l} />)}
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={meta.title[lang]} />
        <meta name="twitter:description" content={meta.description[lang]} />
        <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
      </Fragment>
    )}

    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />

    {noindex && <script is:inline set:html={langRestore} />}

    <!-- Restore saved style + palette BEFORE paint (no flash). Defaults: literary / warm. -->
    <script is:inline>
      (function () {
        var THEMES = ['literary', 'manuscript', 'warm'];
        var PALETTES = ['warm', 'cool', 'bold', 'velvet', 'dusk', 'grove', 'blush', 'night'];
        var t, p;
        try { t = localStorage.getItem('nb.theme'); p = localStorage.getItem('nb.palette'); } catch (e) { /* stateless is fine */ }
        var el = document.documentElement;
        el.dataset.theme = (THEMES.indexOf(t) >= 0) ? t : 'literary';
        el.dataset.palette = (PALETTES.indexOf(p) >= 0) ? p : 'warm';
      })();
    </script>

    <link rel="preload" as="font" type="font/woff2" crossorigin
      href={`${import.meta.env.BASE_URL}fonts/fraunces-latin-normal-300-900.woff2`} />
  </head>
  <body>
    <slot />
    <!-- Style / colour / menu interactions + language-link hash sync. Only client JS on the site. -->
    <script is:inline>
      // cycle-button aria-label = localized base (data-al-<lang>) + current state
      function setSwitchAria(btn, state) {
        if (!btn) return;
        var l = document.documentElement.dataset.lang || 'en';
        var base = btn.getAttribute('data-al-' + l) || btn.getAttribute('aria-label') || '';
        btn.setAttribute('aria-label', base + ' — ' + state);
      }

      var THEMES = ['literary', 'manuscript', 'warm'];
      var THEME_LABELS = { literary: 'Literary', manuscript: 'Manuscript', warm: 'Warm' };
      function applyTheme(name) {
        if (THEMES.indexOf(name) < 0) name = 'literary';
        document.documentElement.dataset.theme = name;
        var btn = document.getElementById('theme-switch');
        if (btn) { var lbl = btn.querySelector('b'); if (lbl) lbl.textContent = THEME_LABELS[name]; setSwitchAria(btn, THEME_LABELS[name]); }
        try { localStorage.setItem('nb.theme', name); } catch (e) { /* fine */ }
      }
      var themeBtn = document.getElementById('theme-switch');
      if (themeBtn) {
        themeBtn.addEventListener('click', function () {
          var cur = document.documentElement.dataset.theme || 'literary';
          var i = THEMES.indexOf(cur);
          applyTheme(THEMES[(i < 0 ? 0 : (i + 1) % THEMES.length)]);
        });
      }
      applyTheme(document.documentElement.dataset.theme || 'literary');

      var PALETTES = ['warm', 'cool', 'bold', 'velvet', 'dusk', 'grove', 'blush', 'night'];
      var PALETTE_LABELS = { warm: 'Warm', cool: 'Cool', bold: 'Bold', velvet: 'Velvet', dusk: 'Dusk', grove: 'Grove', blush: 'Blush', night: 'Night' };
      function applyPalette(name) {
        if (PALETTES.indexOf(name) < 0) name = 'warm';
        document.documentElement.dataset.palette = name;
        var btn = document.getElementById('palette-switch');
        if (btn) { var lbl = btn.querySelector('b'); if (lbl) lbl.textContent = PALETTE_LABELS[name]; setSwitchAria(btn, PALETTE_LABELS[name]); }
        try { localStorage.setItem('nb.palette', name); } catch (e) { /* fine */ }
      }
      var paletteBtn = document.getElementById('palette-switch');
      if (paletteBtn) {
        paletteBtn.addEventListener('click', function () {
          var cur = document.documentElement.dataset.palette || 'warm';
          var pi = PALETTES.indexOf(cur);
          applyPalette(PALETTES[(pi < 0 ? 0 : (pi + 1) % PALETTES.length)]);
        });
      }
      applyPalette(document.documentElement.dataset.palette || 'warm');

      // language link → carry the current section anchor across to the sibling route
      var langLink = document.getElementById('lang-switch');
      if (langLink && langLink.tagName === 'A') {
        var langBase = langLink.getAttribute('href');
        var syncLangHash = function () { langLink.setAttribute('href', langBase + location.hash); };
        syncLangHash();
        window.addEventListener('hashchange', syncLangHash);
      }

      // mobile menu
      var burger = document.getElementById('menu-btn');
      var nav = document.getElementById('site-nav');
      if (burger && nav) {
        burger.addEventListener('click', function () {
          var open = nav.classList.toggle('is-open');
          burger.setAttribute('aria-expanded', String(open));
        });
        nav.addEventListener('click', function (e) {
          if (e.target.closest('a')) { nav.classList.remove('is-open'); burger.setAttribute('aria-expanded', 'false'); }
        });
        var header = document.querySelector('.site-header');
        document.addEventListener('keydown', function (e) {
          if ((e.key === 'Escape' || e.key === 'Esc') && nav.classList.contains('is-open')) {
            nav.classList.remove('is-open'); burger.setAttribute('aria-expanded', 'false'); burger.focus();
          }
        });
        document.addEventListener('click', function (e) {
          if (nav.classList.contains('is-open') && header && !header.contains(e.target)) {
            nav.classList.remove('is-open'); burger.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // CTA → contact with the service dropdown prefilled
      document.querySelectorAll('[data-subject]').forEach(function (el) {
        el.addEventListener('click', function () {
          var sel = document.getElementById('service');
          if (sel) sel.value = el.getAttribute('data-subject');
        });
      });

      // scroll-reveal (respects reduced motion)
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { en.target.classList.add('is-visible'); io.unobserve(en.target); }
          });
        }, { threshold: 0.12 });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
      } else {
        document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('is-visible'); });
      }
    </script>
  </body>
</html>
