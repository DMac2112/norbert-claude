---
import '../styles/global.css';
import '../styles/fonts.css';
import '../styles/palettes.css';
import '../styles/theme-literary.css';
import '../styles/theme-manuscript.css';
import '../styles/theme-warm.css';
import site from '../content/site.json';
const meta = site.meta;
// Canonical URL = deployed project-site root (site + base). Keep all absolute URLs on this base.
const canonical = new URL(import.meta.env.BASE_URL, import.meta.env.SITE).href;
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Norbert Kovács',
  jobTitle: 'Translator & Music Teacher',
  knowsLanguage: ['hu', 'en', 'pl'],
  address: { '@type': 'PostalAddress', addressLocality: 'Poznań', addressCountry: 'PL' },
  url: canonical,
};
---
<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title.en}</title>
    <meta name="description" content={meta.description.en} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={meta.title.en} />
    <meta property="og:description" content={meta.description.en} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:locale:alternate" content="hu_HU" />
    <meta property="og:locale:alternate" content="pl_PL" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <!-- Restore saved language BEFORE paint (no flash of wrong language) -->
    <script is:inline>
      (function () {
        try {
          var l = localStorage.getItem('nb.lang');
          if (l === 'hu' || l === 'pl' || l === 'en') {
            document.documentElement.lang = l;
            document.documentElement.dataset.lang = l;
          }
        } catch (e) { /* stateless is fine */ }
      })();
    </script>
    <!-- Restore saved style + palette BEFORE paint (no flash). Defaults: literary / warm. -->
    <script is:inline>
      (function () {
        var THEMES = ['literary', 'manuscript', 'warm'];
        var PALETTES = ['warm', 'cool', 'bold', 'velvet', 'dusk', 'grove', 'blush', 'night'];
        var t, p;
        try { t = localStorage.getItem('nb.theme'); p = localStorage.getItem('nb.palette'); } catch (e) { /* stateless is fine */ }
        var el = document.documentElement;
        el.dataset.theme = (THEMES.indexOf(t) >= 0) ? t : 'literary';
        el.dataset.palette = (PALETTES.indexOf(p) >= 0) ? p : 'warm';
      })();
    </script>
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href={`${import.meta.env.BASE_URL}fonts/fraunces-latin-normal-300-900.woff2`} />
  </head>
  <body>
    <slot />
    <!-- Master language switch + small interactions. The only client JS on the site. -->
    <script is:inline define:vars={{ META: meta }}>
      var LANGS = ['en', 'hu', 'pl'];

      // keep a cycle-button's aria-label = base label (active language) + current state, e.g.
      // 'Change style (Literary → Manuscript → Warm) — Manuscript' — so SR users hear the live state
      function setSwitchAria(btn, state) {
        if (!btn) return;
        var l = document.documentElement.dataset.lang || 'en';
        var base = btn.getAttribute('data-al-' + l) || btn.getAttribute('aria-label') || '';
        btn.setAttribute('aria-label', base + ' — ' + state);
      }

      function applyLang(l) {
        var root = document.documentElement;
        root.lang = l;
        root.dataset.lang = l;
        document.title = META.title[l];
        var desc = document.querySelector('meta[name="description"]');
        if (desc) desc.setAttribute('content', META.description[l]);
        // attribute-carried strings (placeholders, option labels, aria-labels)
        document.querySelectorAll('[data-ph-en]').forEach(function (el) {
          el.setAttribute('placeholder', el.getAttribute('data-ph-' + l) || '');
        });
        document.querySelectorAll('[data-t-en]').forEach(function (el) {
          el.textContent = el.getAttribute('data-t-' + l) || '';
        });
        document.querySelectorAll('[data-al-en]').forEach(function (el) {
          el.setAttribute('aria-label', el.getAttribute('data-al-' + l) || '');
        });
        var btn = document.getElementById('lang-switch');
        if (btn) btn.querySelector('b').textContent = l.toUpperCase();
        // the loop above reset the cycle buttons to their base label — re-append their live state
        if (typeof THEME_LABELS !== 'undefined') setSwitchAria(document.getElementById('theme-switch'), THEME_LABELS[root.dataset.theme] || '');
        if (typeof PALETTE_LABELS !== 'undefined') setSwitchAria(document.getElementById('palette-switch'), PALETTE_LABELS[root.dataset.palette] || '');
        try { localStorage.setItem('nb.lang', l); } catch (e) { /* fine */ }
      }

      // master switch: EN → HU → PL → EN, always visible in the sticky header
      var switchBtn = document.getElementById('lang-switch');
      if (switchBtn) {
        switchBtn.addEventListener('click', function () {
          var cur = document.documentElement.dataset.lang || 'en';
          var next = LANGS[(LANGS.indexOf(cur) + 1) % LANGS.length];
          applyLang(next);
        });
      }
      applyLang(document.documentElement.dataset.lang || 'en'); // sync attrs w/ stored lang

      var THEMES = ['literary', 'manuscript', 'warm'];
      var THEME_LABELS = { literary: 'Literary', manuscript: 'Manuscript', warm: 'Warm' };

      function applyTheme(name) {
        if (THEMES.indexOf(name) < 0) name = 'literary';
        document.documentElement.dataset.theme = name;
        var btn = document.getElementById('theme-switch');
        if (btn) { var lbl = btn.querySelector('b'); if (lbl) lbl.textContent = THEME_LABELS[name]; setSwitchAria(btn, THEME_LABELS[name]); }
        try { localStorage.setItem('nb.theme', name); } catch (e) { /* fine */ }
      }

      // style switch: cycles Literary → Manuscript → Warm, always visible in the sticky header
      var themeBtn = document.getElementById('theme-switch');
      if (themeBtn) {
        themeBtn.addEventListener('click', function () {
          var cur = document.documentElement.dataset.theme || 'literary';
          var i = THEMES.indexOf(cur);
          applyTheme(THEMES[(i < 0 ? 0 : (i + 1) % THEMES.length)]);
        });
      }
      applyTheme(document.documentElement.dataset.theme || 'literary'); // sync button label w/ restored theme

      var PALETTES = ['warm', 'cool', 'bold', 'velvet', 'dusk', 'grove', 'blush', 'night'];
      var PALETTE_LABELS = { warm: 'Warm', cool: 'Cool', bold: 'Bold', velvet: 'Velvet', dusk: 'Dusk', grove: 'Grove', blush: 'Blush', night: 'Night' };

      function applyPalette(name) {
        if (PALETTES.indexOf(name) < 0) name = 'warm';
        document.documentElement.dataset.palette = name;
        var btn = document.getElementById('palette-switch');
        if (btn) { var lbl = btn.querySelector('b'); if (lbl) lbl.textContent = PALETTE_LABELS[name]; setSwitchAria(btn, PALETTE_LABELS[name]); }
        try { localStorage.setItem('nb.palette', name); } catch (e) { /* fine */ }
      }

      // colour switch: cycles Warm → Cool → Bold, independent of the style
      var paletteBtn = document.getElementById('palette-switch');
      if (paletteBtn) {
        paletteBtn.addEventListener('click', function () {
          var cur = document.documentElement.dataset.palette || 'warm';
          var pi = PALETTES.indexOf(cur);
          applyPalette(PALETTES[(pi < 0 ? 0 : (pi + 1) % PALETTES.length)]);
        });
      }
      applyPalette(document.documentElement.dataset.palette || 'warm'); // sync button label w/ restored palette

      // mobile menu
      var burger = document.getElementById('menu-btn');
      var nav = document.getElementById('site-nav');
      if (burger && nav) {
        burger.addEventListener('click', function () {
          var open = nav.classList.toggle('is-open');
          burger.setAttribute('aria-expanded', String(open));
        });
        nav.addEventListener('click', function (e) {
          if (e.target.closest('a')) { nav.classList.remove('is-open'); burger.setAttribute('aria-expanded', 'false'); }
        });
        // close on Escape or a click outside the header, keeping aria-expanded in sync
        var header = document.querySelector('.site-header');
        document.addEventListener('keydown', function (e) {
          if ((e.key === 'Escape' || e.key === 'Esc') && nav.classList.contains('is-open')) {
            nav.classList.remove('is-open'); burger.setAttribute('aria-expanded', 'false'); burger.focus();
          }
        });
        document.addEventListener('click', function (e) {
          if (nav.classList.contains('is-open') && header && !header.contains(e.target)) {
            nav.classList.remove('is-open'); burger.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // CTA → contact with the service dropdown prefilled
      document.querySelectorAll('[data-subject]').forEach(function (el) {
        el.addEventListener('click', function () {
          var sel = document.getElementById('service');
          if (sel) sel.value = el.getAttribute('data-subject');
        });
      });

      // scroll-reveal (respects reduced motion)
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) { en.target.classList.add('is-visible'); io.unobserve(en.target); }
          });
        }, { threshold: 0.12 });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
      } else {
        document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('is-visible'); });
      }
    </script>
  </body>
</html>
